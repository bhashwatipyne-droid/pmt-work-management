# Copy these into the backend's environment (hosting dashboard) or into
# backend/.env for local runs. Never commit real values.

# --- Password-reset emails (SMTP) ---
# Gmail / Google Workspace: use the sending account's address and a 16-character
# App Password (Google Account > Security > 2-Step Verification > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=PMT <you@yourdomain.com>
SMTP_STARTTLS=true
# The address people open the app at, no trailing slash (used in the reset link).
FRONTEND_URL=https://your-live-app-address
